NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
APP_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
GOOGLE_AUTH_CALLBACK_URL=http://127.0.0.1:54321/auth/v1/callback
# Example Jobs appear automatically in dev; opt in for a production-mode local preview.
SHOW_DEMO_JOBS=false

RESEND_API_KEY=
SUPABASE_SECRET_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
# Local/Preview dummy keys only. This is rejected automatically in Production.
TURNSTILE_TEST_MODE=false

GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Server-only Google Drive integration through Vercel OIDC federation.
# Do not use NEXT_PUBLIC_ and do not add a service-account JSON key.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# Optional: only set this when the Workload Identity provider uses its generated default audience.
GCP_AUDIENCE=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SOP_ROOT_FOLDER_ID=
